configuration {
    modi:                   "drun,run,window";
    show-icons:             true;
    drun-display-format:    "{name}";
    display-drun:           "  Apps";
    display-run:            "  Run";
    display-window:         "  Windows";
    icon-theme:             "Papirus-Dark";
    terminal:               "kitty";
}

@theme "~/.config/rofi/themes/catppuccin-mocha.rasi"
