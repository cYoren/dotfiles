{
  "bar": {
    "background": "glassy",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.weather"
        },
        {
          "cities": [
            {
              "name": "San Francisco",
              "zone": "America/Los_Angeles"
            },
            {
              "name": "Berlin",
              "zone": "Europe/Berlin"
            },
            {
              "name": "Beijing",
              "zone": "Asia/Shanghai"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            }
          ],
          "hour24": true,
          "id": "omarchy.elsewhen",
          "offsetMode": "utc"
        },
        {
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/sysstats",
          "fontSize": 11,
          "id": "sysstats",
          "interval": 5,
          "onClick": "omarchy-launch-or-focus-tui btop",
          "type": "command"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "gus.dev-launcher"
        },
        {
          "id": "gus.dev-sync"
        },
        {
          "id": "shavanced.notification-center"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.media"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "tray": []
    },
    "position": "top"
  },
  "dock": {
    "pinned": [
      "org.gnome.Nautilus",
      "foot",
      "omacalc",
      "omawrite",
      "X"
    ]
  },
  "idle": {
    "lock": 300,
    "screensaver": 301
  },
  "plugins": [
    {
      "id": "piyush.omaswitch"
    },
    {
      "id": "zzwong.stage"
    },
    {
      "id": "bobbynicholas.omaland"
    }
  ],
  "version": 1
}
