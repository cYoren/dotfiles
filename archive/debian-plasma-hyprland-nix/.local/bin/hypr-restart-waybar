#!/bin/bash
set -euo pipefail

pkill -x waybar >/dev/null 2>&1 || true
sleep 0.3

WAYBAR_BIN="$(command -v waybar || true)"

if [ -z "${WAYBAR_BIN}" ] && [ -x "${HOME}/.nix-profile/bin/waybar" ]; then
    WAYBAR_BIN="${HOME}/.nix-profile/bin/waybar"
fi

if [ -z "${WAYBAR_BIN}" ]; then
    echo "waybar not found" >&2
    exit 1
fi

exec "${WAYBAR_BIN}" -c "${HOME}/.config/waybar/config.jsonc" -s "${HOME}/.config/waybar/style.css"
