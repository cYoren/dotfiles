#!/bin/bash
set -euo pipefail

notify_user() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$1" "$2"
    else
        printf '%s: %s\n' "$1" "$2" >&2
    fi
}

if command -v rofi >/dev/null 2>&1; then
    choice="$(
        printf '%s\n' "Lock" "Logout" "Suspend" "Reboot" "Shutdown" |
            rofi -dmenu -i -p 'Power'
    )"
elif command -v wofi >/dev/null 2>&1; then
    choice="$(
        printf '%s\n' "Lock" "Logout" "Suspend" "Reboot" "Shutdown" |
            wofi --show dmenu --prompt 'Power'
    )"
else
    notify_user "Power menu unavailable" "Install rofi or wofi to use the power menu."
    exit 1
fi

case "${choice:-}" in
    Lock)
        if command -v hyprlock >/dev/null 2>&1; then
            exec hyprlock
        fi
        exec loginctl lock-session
        ;;
    Logout)
        exec hyprctl dispatch exit
        ;;
    Suspend)
        systemctl suspend
        ;;
    Reboot)
        systemctl reboot
        ;;
    Shutdown)
        systemctl poweroff
        ;;
esac
